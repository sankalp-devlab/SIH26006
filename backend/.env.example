# OceanLens Maritime Intelligence Platform — Backend Environment Configuration
# Copy this file to backend/.env for local development

# Supabase Project Credentials (PostgreSQL / PostgREST)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# CORS Allowed Origins (Comma-separated)
# In production, include your deployed frontend domain (e.g. https://oceanlens.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Optional Commercial AIS Telemetry Provider (Spire / AISStream)
# If left empty, tracking engine operates against authentic telemetry in public.vessel_positions
AIS_API_KEY=
AIS_PROVIDER_URL=
