# OceanLens Maritime Intelligence Platform — Frontend Environment Configuration
# Copy this file to .env.local or .env for local development

# Centralized FastAPI Backend URL
# Production: Set to your deployed Render backend (e.g. https://oceanlens-backend.onrender.com)
# Development: http://127.0.0.1:8000
VITE_API_BASE_URL=https://oceanlens-backend.onrender.com

# Optional Map Tile Provider (CARTO Basemaps API Key)
# Default public CARTO Voyager basemap works without key
VITE_CARTO_API_KEY=
